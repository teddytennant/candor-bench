# candor-bench environment variables
# Copy this file to .env and fill in your keys.
#
# The benchmark will automatically load this file (via python-dotenv)
# when you run `candor`.

# ==========================================
# xAI  (the reference provider; used by the xai: adapter)
# ==========================================
XAI_API_KEY=                     # <-- put your xAI key here (starts with xai-)
# XAI_BASE_URL defaults to https://api.x.ai/v1; override only if you proxy it.
# XAI_BASE_URL=https://api.x.ai/v1

# ==========================================
# OpenAI
# ==========================================
# OPENAI_API_KEY=

# ==========================================
# OpenRouter  (hosted gateway for open-weight models; openrouter: adapter)
# ==========================================
# OpenRouter is OpenAI-compatible at https://openrouter.ai/api/v1 and fronts
# Llama / Qwen / Mistral / Gemma / etc. under `vendor/model` ids.
# OPENROUTER_API_KEY=        # <-- put your OpenRouter key here (starts with sk-or-)

# ==========================================
# Kaggle Benchmarks Model Proxy  (kaggle: adapter)
# ==========================================
# A hosted OpenAI-compatible gateway. Don't hand-edit these — run
# `kaggle benchmarks auth` (pip install kaggle) to provision them. The
# credential is short-lived (~1h); re-run auth to refresh. The kaggle: adapter
# appends the proxy's /openapi surface automatically.
# MODEL_PROXY_URL=
# MODEL_PROXY_API_KEY=

# ==========================================
# Any other OpenAI-compatible endpoint (local: adapter)
# ==========================================
# LOCAL_BASE_URL points at any /v1 server: llama.cpp, vLLM, ollama, LM Studio,
# or a hosted gateway. The xai: adapter also falls back to these if XAI_* is
# unset, so an existing .env pointed at api.x.ai keeps working.
# LOCAL_BASE_URL=http://localhost:8080/v1
# LOCAL_API_KEY=

# ==========================================
# Notes
# ==========================================
# - xAI standard models:        candor run --model xai:grok-4.3
# - xAI multi-agent models:      candor run --model xai-responses:grok-4.20-multi-agent-0309
# - OpenAI:                      candor run --model openai:gpt-4o-mini
# - OpenRouter (open weights):   candor run --model openrouter:meta-llama/llama-3.1-8b-instruct
# - Kaggle Model Proxy:          candor run --model kaggle:anthropic/claude-haiku-4-5@20251001
# - Any OpenAI-compatible server: candor run --model local:llama-3.1-8b-instruct
